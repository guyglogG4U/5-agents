# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים.
# קובץ .env עצמו לא נשמר ב-git (ראה .gitignore).
#   cp .env.example .env

# --- Anthropic (המוח של הסוכנים) ---
ANTHROPIC_API_KEY=

# --- כללי ---
# סביבת הרצה: development | production
ENV=development
